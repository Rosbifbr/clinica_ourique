<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-12">
      <%= form_with(model: client, class: "card shadow-lg") do |form| %>
        <div class="card-header bg-primary bg-gradient text-white py-3">
          <h4 class="card-title mb-0">
            <i class="bi bi-person-fill me-2"></i>
            <%= client.new_record? ? "New Client" : "Edit Client" %>
          </h4>
        </div>

        <div class="card-body p-4">
          <% if client.errors.any? %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <h6 class="mb-0"><%= pluralize(client.errors.count, "error") %> prohibited this client from being saved:</h6>
              </div>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              <ul class="mb-0 mt-2">
                <% client.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="row g-3 fs-5">
            <div class="col-12">
              <%= form.label :name, class: "form-label fw-medium" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <%= form.text_field :name, class: "form-control", placeholder: "Enter name" %>
              </div>
            </div>

            <div class="col-md-6">
              <%= form.label :cpf, class: "form-label fw-medium" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                <%= form.text_field :cpf, class: "form-control", placeholder: "Enter CPF", oninput: "formatCPF(this)" %>
              </div>
            </div>

            <div class="col-md-6">
              <%= form.label :phone, class: "form-label fw-medium" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                <%= form.text_field :phone, class: "form-control", placeholder: "Enter phone number", oninput: "formatPhone(this)" %>
              </div>
            </div>

            <div class="col-md-6">
              <%= form.label :birthdate, class: "form-label fw-medium" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                <%= form.date_field :birthdate, class: "form-control" %>
              </div>
            </div>

            <div class="col-md-6">
              <%= form.label :postal_code, class: "form-label fw-medium" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                <%= form.text_field :postal_code, class: "form-control", placeholder: "Enter postal code", oninput: "formatPostalCode(this)" %>
              </div>
            </div>

            <div class="col-12">
              <%= form.label :address, class: "form-label fw-medium" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-house"></i></span>
                <%= form.text_field :address, class: "form-control", placeholder: "Enter address" %>
              </div>
            </div>

            <div class="col-12">
              <%= form.label :neighborhood, class: "form-label fw-medium" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-building"></i></span>
                <%= form.text_field :neighborhood, class: "form-control", placeholder: "Enter neighborhood" %>
              </div>
            </div>
          </div>

            <div class="col-12 mt-5">
              <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h4 class="mb-0">
                  <i class="bi bi-journal-text me-2"></i>Client Observation
                </h4>
              </div>
              <%= form.text_area :observation, class: "bg-light form-control", placeholder: "Enter observation for this client", rows: 3%>
            </div>

            <!-- Image Upload Section -->
            <div class="mt-4">
              <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h4 class="mb-0">
                  <i class="bi bi-image me-2"></i>Client Images
                </h4>
              </div>
              <div class="mb-3">
                <%= form.file_field :images, multiple: true, class: "form-control" %>
              </div>
            </div>

            <!-- Dental Map Section (ActiveStorage) -->
            <div class="mt-4">
              <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h4 class="mb-0"><i class="bi bi-grid-3x3-gap me-2"></i>Dental Map</h4>
              </div>
              <div class="mb-3">
                <%= form.label :dental_map, class: "form-label fw-medium" %>
                <%= form.file_field :dental_map, class: "form-control" %>
              </div>
              <% if @client.dental_map.attached? %>
                <div class="mb-3">
                  <%= image_tag @client.dental_map.representation(resize_to_limit: [300, 300]), class: "img-fluid rounded mx-auto d-block", style: "max-height: 300px; box-shadow: 0 2px 5px rgba(0,0,0,0.1);" %>
                  <%# Add a way to remove the dental map if needed. Requires a custom route or direct ActiveStorage blob deletion. %>
                  <%# Example: link_to "Remove Dental Map", delete_dental_map_client_path(@client), method: :delete, data: { confirm: \"Are you sure?\" } %>
                </div>
              <% else %>
                <div class="alert alert-info d-flex align-items-center">
                    <i class="bi bi-info-circle me-2 fs-5"></i>
                    <div>No dental map uploaded.</div>
                </div>
              <% end %>
            </div>
        </div>

        <div class="card-footer bg-light p-3">
          <div class="d-flex justify-content-end gap-2">
            <% if defined?(clients_path) %>
              <%= link_to clients_path, class: "btn btn-outline-secondary" do %>
                <i class="bi bi-x-circle me-1"></i>Cancel
              <% end %>
            <% end %>
            <%= form.submit class: "btn btn-primary", value: client.new_record? ? "Create Client" : "Update Client" do %>
              <i class="bi bi-check-circle me-1"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  function formatCPF(input) {
    let value = input.value.replace(/\D/g, "");
    if (value.length > 11) value = value.slice(0, 11);
    input.value = value.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, "$1.$2.$3-$4");
  }

  function formatPhone(input) {
    let value = input.value.replace(/\D/g, "");
    if (value.length > 11) value = value.slice(0, 11);
    input.value = value.replace(/(\d{2})(\d{5})(\d{4})/, "($1) $2-$3");
  }

  function formatPostalCode(input) {
    let value = input.value.replace(/\D/g, "");
    if (value.length > 8) value = value.slice(0, 8);
    input.value = value.replace(/(\d{5})(\d{3})/, "$1-$2");
  }
</script>
