<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-10 col-lg-8"> <!-- Adjusted main column for potentially wider content due to condensation -->
      <%= form_with(model: client, class: "card shadow-lg") do |form| %>
        <div class="card-header bg-primary bg-gradient text-white py-3">
          <h4 class="card-title mb-0">
            <i class="bi bi-person-fill me-2"></i>
            <%= client.new_record? ? "New Client" : "Edit Client" %>
          </h4>
        </div>

        <div class="card-body p-3"> <!-- Reduced padding in card-body -->
          <% if client.errors.any? %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <h6 class="mb-0"><%= pluralize(client.errors.count, "error") %> prohibited this client from being saved:</h6>
              </div>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              <ul class="mb-0 mt-2">
                <% client.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="row g-2 fs-5"> <!-- Reduced gutter 'g-2' -->
            <div class="col-12 mb-2"> <!-- Reduced margin 'mb-2' -->
              <%= form.label :name, class: "form-label fw-medium mb-1" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-person"></i></span>
                <%= form.text_field :name, class: "form-control form-control-sm", placeholder: "Enter name" %>
              </div>
            </div>

            <div class="col-md-6 mb-2">
              <%= form.label :cpf, class: "form-label fw-medium mb-1" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                <%= form.text_field :cpf, class: "form-control form-control-sm", placeholder: "Enter CPF", oninput: "formatCPF(this)" %>
              </div>
            </div>

            <div class="col-md-6 mb-2">
              <%= form.label :birthdate, class: "form-label fw-medium mb-1" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                <%= form.date_field :birthdate, class: "form-control form-control-sm" %>
              </div>
            </div>

            <div class="col-md-6 mb-2">
              <%= form.label :phone, "Phone 1", class: "form-label fw-medium mb-1" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                <%= form.text_field :phone, class: "form-control form-control-sm", placeholder: "Enter phone 1", oninput: "formatPhone(this)" %>
              </div>
            </div>

            <div class="col-md-6 mb-2"> <!-- Added Phone 2 -->
              <%= form.label :phone2, "Phone 2 (Optional)", class: "form-label fw-medium mb-1" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-telephone-plus"></i></span>
                <%= form.text_field :phone2, class: "form-control form-control-sm", placeholder: "Enter phone 2 (optional)", oninput: "formatPhone(this)" %>
              </div>
            </div>

            <div class="col-12 mb-2">
              <%= form.label :address, "Address (Optional)", class: "form-label fw-medium mb-1" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-house"></i></span>
                <%= form.text_field :address, class: "form-control form-control-sm", placeholder: "Enter address" %>
              </div>
            </div>

            <div class="col-md-6 mb-2">
              <%= form.label :postal_code, "Postal Code (Optional)", class: "form-label fw-medium mb-1" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-geo-alt"></i></span>
                <%= form.text_field :postal_code, class: "form-control form-control-sm", placeholder: "Enter postal code", oninput: "formatPostalCode(this)" %>
              </div>
            </div>

            <div class="col-md-6 mb-2">
              <%= form.label :neighborhood, class: "form-label fw-medium mb-1" %>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-building"></i></span>
                <%= form.text_field :neighborhood, class: "form-control form-control-sm", placeholder: "Enter neighborhood" %>
              </div>
            </div>
          </div>

            <div class="col-12 mt-3 mb-2"> <!-- Reduced margin 'mt-3 mb-2' -->
              <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2">
                <h5 class="mb-0"> <!-- Reduced heading size -->
                  <i class="bi bi-journal-text me-2"></i>Client Observation
                </h5>
              </div>
              <%= form.text_area :observation, class: "bg-light form-control form-control-sm", placeholder: "Enter observation for this client", rows: 2 %> <!-- Reduced rows -->
            </div>

            <!-- Image Upload Section -->
            <div class="mt-3 mb-2">
              <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2">
                <h5 class="mb-0">
                  <i class="bi bi-image me-2"></i>Client Images
                </h5>
              </div>
              <div class="mb-2">
                <%= form.file_field :images, multiple: true, class: "form-control form-control-sm" %>
              </div>
            </div>

            <!-- Dental Map Section (Fabric.js Editor) -->
            <!-- Odontogram editing is NOT allowed on client creation as per new requirements -->
            <!-- This section will only show for EDITING an existing client -->

            <div class="mt-3"
                                         data-controller="odontogram-editor"
                                         data-odontogram-editor-image-url-value="<%= asset_path('default_odontogram.png') %>"
                                         data-odontogram-editor-json-url-value="<%= client.dental_map.attached? ? url_for(client.dental_map) : '' %>">
              <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2">
                <h5 class="mb-0"><i class="bi bi-pencil-ruler me-2"></i>Dental Map Editor</h5>
              </div>
              <!-- Free drawing toolbar -->
              <div class="mb-2 d-flex align-items-center gap-2">
                <label class="mb-0">Color: <input type="color" id="brush-color" value="#000000"></label>
                <label class="mb-0">Size: <input type="range" id="brush-size" min="1" max="50" value="5"></label>
                <button type="button" id="clear-drawing" class="btn btn-sm btn-warning">Clear Drawing</button>
                <button type="button" id="zoom-in" class="btn btn-sm btn-secondary">Zoom In</button>
                <button type="button" id="zoom-out" class="btn btn-sm btn-secondary">Zoom Out</button>
              </div>
              <div class="mb-2 text-center" style="border: 1px solid #ccc; background-color: #f8f9fa; overflow: auto;">
                <canvas data-odontogram-editor-target="canvas" style="display: block; margin: auto;"></canvas>
              </div>
              <%# Hidden field to store the Fabric.js canvas JSON data %>
              <%= form.hidden_field :dental_map_json, data: { odontogram_editor_target: "canvasJsonOutput" } %>
            </div>
            <!-- Fabric.js CDN and dental map editor logic -->
            <script src="https://cdnjs.cloudflare.com/ajax/libs/fabric.js/5.3.0/fabric.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
            <script>
              document.addEventListener("DOMContentLoaded", function() {
                // Only run if the dental map editor section exists
                var odontogramSection = document.querySelector('[data-controller="odontogram-editor"]');
                if (!odontogramSection) return;

                var canvasElem = odontogramSection.querySelector('canvas[data-odontogram-editor-target="canvas"]');
                var hiddenJsonField = odontogramSection.querySelector('input[name="client[dental_map_json]"]');
                var imageUrl = odontogramSection.dataset.odontogramEditorImageUrlValue;
                var canvas = new fabric.Canvas(canvasElem, {
                  preserveObjectStacking: true
                });
                // Enable free drawing
                canvas.isDrawingMode = true;
                canvas.freeDrawingBrush.color = '#000000';
                canvas.freeDrawingBrush.width = 5;
                // Load background image
                if (imageUrl && imageUrl.length) {
                  fabric.Image.fromURL(imageUrl, function(img) {
                    canvas.setBackgroundImage(img, function() {
                      canvas.setWidth(img.width);
                      canvas.setHeight(img.height);
                      // Load saved drawing from JSON URL if present
                      var jsonUrl = odontogramSection.dataset.odontogramEditorJsonUrlValue;
                      if (jsonUrl && jsonUrl.length) {
                        fetch(jsonUrl)
                          .then(function(resp) { return resp.text(); })
                          .then(function(json) {
                            hiddenJsonField.value = json;
                            canvas.loadFromJSON(json, function() {
                              // Reapply background after drawing loaded
                              canvas.setBackgroundImage(img, function() {
                                canvas.renderAll();
                                syncCanvasJson();
                              }, { originX: 'left', originY: 'top' });
                            });
                          });
                      } else {
                        canvas.renderAll();
                        syncCanvasJson();
                      }
                    }, { originX: 'left', originY: 'top' });
                  });
                }



                // Sync canvas JSON to hidden field
                function syncCanvasJson() {
                  hiddenJsonField.value = JSON.stringify(canvas.toJSON());
                }
                canvas.on('object:added', syncCanvasJson);
                canvas.on('object:modified', syncCanvasJson);
                canvas.on('object:removed', syncCanvasJson);
                canvas.on('object:moving', syncCanvasJson);
                canvas.on('object:scaling', syncCanvasJson);
                canvas.on('object:rotating', syncCanvasJson);

                // Also sync on form submit
                var form = odontogramSection.closest('form');
                if (form) {
                  form.addEventListener('submit', syncCanvasJson);
                }

                // Toolbar controls
                var colorInput = document.getElementById('brush-color');
                var sizeInput = document.getElementById('brush-size');
                var clearBtn = document.getElementById('clear-drawing');
                var zoomInBtn = document.getElementById('zoom-in');
                var zoomOutBtn = document.getElementById('zoom-out');
                colorInput.addEventListener('change', function() { canvas.freeDrawingBrush.color = this.value; });
                sizeInput.addEventListener('change', function() { canvas.freeDrawingBrush.width = parseInt(this.value, 10); });
                clearBtn.addEventListener('click', function() {
                  // Remove all drawn objects but keep background
                  var objs = canvas.getObjects().slice();
                  objs.forEach(function(obj) { canvas.remove(obj); });
                  canvas.renderAll();
                  syncCanvasJson();
                });
                // Zoom controls
                zoomInBtn.addEventListener('click', function() {
                  var zoom = canvas.getZoom() || 1;
                  zoom *= 1.1;
                  canvas.setZoom(zoom);
                });
                zoomOutBtn.addEventListener('click', function() {
                  var zoom = canvas.getZoom() || 1;
                  zoom /= 1.1;
                  canvas.setZoom(zoom);
                });
                // Mouse wheel zoom
                canvas.on('mouse:wheel', function(opt) {
                  var delta = opt.e.deltaY;
                  var zoom = canvas.getZoom() || 1;
                  zoom *= 0.999 ** delta;
                  if (zoom > 20) zoom = 20;
                  if (zoom < 0.01) zoom = 0.01;
                  canvas.zoomToPoint({ x: opt.e.offsetX, y: opt.e.offsetY }, zoom);
                  opt.e.preventDefault();
                  opt.e.stopPropagation();
                });

                // Initial sync
                syncCanvasJson();
                });
              </script>
          </div>
          <div class="card-footer bg-light p-2"> <!-- Reduced padding -->
              <div class="d-flex justify-content-end gap-2">
                <% if defined?(clients_path) %>
                  <%= link_to clients_path, class: "btn btn-outline-secondary btn-sm" do %>
                    <i class="bi bi-x-circle me-1"></i>Cancel
                  <% end %>
                <% end %>
                <%= form.submit class: "btn btn-primary btn-sm", value: client.new_record? ? "Create Client" : "Update Client" %>
              </div>
            </div>
          <% end %>  <!-- closes form_with -->
        </div>
      </div>
  </div>

<script>
  // Existing JS functions for formatting CPF, Phone, Postal Code remain unchanged
  function formatCPF(input) {
    let value = input.value.replace(/\D/g, "");
    if (value.length > 11) value = value.slice(0, 11);
    input.value = value.replace(/(\d{3})(\d{3})(\d{3})(\d{2})/, "\$1.\$2.\$3-\$4");
  }

  function formatPhone(input) {
    let value = input.value.replace(/\D/g, "");
    if (value.length > 11) value = value.slice(0, 11);
    // Allow for 10 or 11 digits (e.g. (XX) XXXX-XXXX or (XX) XXXXX-XXXX)
    if (value.length === 11) {
      input.value = value.replace(/(\d{2})(\d{5})(\d{4})/, "(\$1) \$2-\$3");
    } else if (value.length === 10) {
      input.value = value.replace(/(\d{2})(\d{4})(\d{4})/, "(\$1) \$2-\$3");
    }
    // else it will just show the numbers as typed if not 10 or 11
  }

  function formatPostalCode(input) {
    let value = input.value.replace(/\D/g, "");
    if (value.length > 8) value = value.slice(0, 8);
    input.value = value.replace(/(\d{5})(\d{3})/, "\$1-\$2");
  }
</script>
