<div class="container mt-4">
  <h2 class="mb-4"><i class="bi bi-file-earmark-bar-graph me-2"></i>Financial Report</h2>

  <%= form_with(url: "/reports/financial", method: :get, class: "mb-4 p-3 border rounded bg-light") do |form| %>
    <div class="row g-3 align-items-end">
      <div class="col-md-4">
        <%= form.label :client_id, "Client", class: "form-label" %>
        <%= form.collection_select :client_id, @clients, :id, :name, { include_blank: "All Clients", selected: params[:client_id] }, class: "form-select form-select-sm" %>
      </div>
      <div class="col-md-3">
        <%= form.label :start_date, "Start Date", class: "form-label" %>
        <%= form.date_field :start_date, value: params[:start_date], class: "form-control form-control-sm" %>
      </div>
      <div class="col-md-3">
        <%= form.label :end_date, "End Date", class: "form-label" %>
        <%= form.date_field :end_date, value: params[:end_date], class: "form-control form-control-sm" %>
      </div>
      <div class="col-md-2">
        <%= form.submit "Filter", class: "btn btn-primary btn-sm w-100" %>
      </div>
    </div>
  <% end %>

  <div class="card mb-4">
    <div class="card-header fw-bold">Overall Summary</div>
    <div class="card-body">
      <div class="row text-center">
        <div class="col-md-4">
          <h6 class="text-muted">Total Debit</h6>
          <p class="fs-5 text-danger fw-bold"><%= number_to_currency(@total_debit, unit: "R$") %></p>
        </div>
        <div class="col-md-4">
          <h6 class="text-muted">Total Credit</h6>
          <p class="fs-5 text-success fw-bold"><%= number_to_currency(@total_credit, unit: "R$") %></p>
        </div>
        <div class="col-md-4">
          <h6 class="text-muted">Net Balance</h6>
          <p class="fs-5 fw-bolder <%= @net_balance >= 0 ? 'text-success' : 'text-danger' %>">
            <%= number_to_currency(@net_balance, unit: "R$") %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <h3 class="mb-3 h5">Summary by Client</h3>
  <% if @financial_summary_by_client.any? %>
    <div class="table-responsive">
      <table class="table table-sm table-striped table-bordered">
        <thead class="table-light">
          <tr>
            <th>Client Name</th>
            <th class="text-end">Total Debit</th>
            <th class="text-end">Total Credit</th>
            <th class="text-end">Net Balance</th>
          </tr>
        </thead>
        <tbody>
          <% @financial_summary_by_client.each do |summary| %>
            <tr>
              <td><%= summary.client_name %></td>
              <td class="text-end text-danger"><%= number_to_currency(summary.total_debit || 0, unit: "R$") %></td>
              <td class="text-end text-success"><%= number_to_currency(summary.total_credit || 0, unit: "R$") %></td>
              <td class="text-end fw-bold <%= (summary.total_debit.to_f - summary.total_credit.to_f) >= 0 ? 'text-success' : 'text-danger' %>">
                <%= number_to_currency(summary.total_debit.to_f - summary.total_credit.to_f, unit: "R$") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info">No financial data found for the selected filters.</div>
  <% end %>
</div>
