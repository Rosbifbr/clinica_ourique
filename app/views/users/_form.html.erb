<div class="container mt-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-5">
      <%= form_with(model: user, class: "card shadow-lg") do |form| %>
        <div class="card-header bg-primary bg-gradient text-white py-3">
          <h4 class="card-title mb-0">
            <i class="bi bi-person-circle me-2"></i>
            <%= user.new_record? ? "Create User" : "Edit User" %>
          </h4>
        </div>

        <div class="card-body p-4">
          <% if user.errors.any? %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <h6 class="mb-0"><%= pluralize(user.errors.count, "error") %> prohibited this account from being saved:</h6>
              </div>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              <ul class="mb-0 mt-2">
                <% user.errors.each do |error| %>
                  <li><%= error.full_message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div class="mb-3"> <!-- Changed mb-4 to mb-3 for consistency -->
            <%= form.label :name, class: "form-label fw-medium" %>
            <div class="input-group">
              <span class="input-group-text">
                <i class="bi bi-person"></i>
              </span>
              <%= form.text_field :name,
                  class: "form-control",
                  placeholder: "Enter your name",
                  autocomplete: "name" %>
            </div>
          </div>

          <div class="mb-3"> <!-- Added Email field -->
            <%= form.label :email, class: "form-label fw-medium" %>
            <div class="input-group">
              <span class="input-group-text">
                <i class="bi bi-envelope"></i>
              </span>
              <%= form.email_field :email,
                  class: "form-control",
                  placeholder: "Enter your email",
                  autocomplete: "email" %>
            </div>
          </div>

          <div class="mb-3"> <!-- Changed mb-4 to mb-3 -->
            <%= form.label :password, class: "form-label fw-medium" %>
            <div class="input-group">
              <span class="input-group-text">
                <i class="bi bi-key"></i>
              </span>
              <%= form.password_field :password,
                  class: "form-control",
                  placeholder: "Enter your password",
                  autocomplete: "new-password" %>
            </div>
            <% unless user.persisted? %> <!-- Show length hint only for new users or if password is being set -->
              <div class="form-text text-muted">
                <i class="bi bi-info-circle me-1"></i>
                Password should be at least 6 characters long.
              </div>
            <% end %>
          </div>

          <div class="mb-4"> <!-- Added Password Confirmation field -->
            <%= form.label :password_confirmation, class: "form-label fw-medium" %>
            <div class="input-group">
              <span class="input-group-text">
                <i class="bi bi-key-fill"></i>
              </span>
              <%= form.password_field :password_confirmation,
                  class: "form-control",
                  placeholder: "Confirm your password",
                  autocomplete: "new-password" %>
            </div>
          </div>
        </div>

        <div class="card-footer bg-light p-3">
          <div class="d-flex justify-content-center gap-3">
            <% if defined?(users_path) && user.persisted? %> <!-- Show cancel only if user persisted, or adjust as needed -->
              <%= link_to users_path, class: "btn btn-outline-secondary" do %>
                <i class="bi bi-x-circle me-1"></i>Cancel
              <% end %>
            <% elsif !user.persisted? && defined?(root_path) %> <!-- Link to root or sign in for new user cancel -->
               <%= link_to "Cancel", root_path, class: "btn btn-outline-secondary" %>
            <% end %>
            <%= form.submit class: "btn btn-primary", value: user.new_record? ? "Create User" : "Update Account" %>
            <%# Original submit had an icon, which is fine. Re-adding for completeness if form.submit doesn't take a block well here. %>
            <%# If form.submit needs a block for icon: %>
            <%#= form.button type: :submit, class: "btn btn-primary" do %>
              <%# <i class="bi bi-check-circle me-1"></i> <%= user.new_record? ? "Create User" : "Update Account" %>
            <%# <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
